# Copy to .env.local for local development. Never commit real values.

# Public site URL (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Settings > API). The anon key is the only key that reaches the browser;
# row-level security protects data (R-NF-06).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI writing feedback (server only). Without a key, learners still see the correct answer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_DAILY_LIMIT=10

# Shown on /privacy for account deletion requests (R-AC-04). Set before launch.
NEXT_PUBLIC_CONTACT_EMAIL=
