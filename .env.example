# Copy to .env.local for local development. Never commit real values.

# Public site URL (used for OAuth redirects in Part 1)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Settings > API). The anon key is safe in the browser;
# row-level security protects data. Keep the service-role key server-side only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
